<Window x:Class="NssWpfHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NUCtool · WPF 原版模块验证" Width="1180" Height="760"
        MinWidth="900" MinHeight="600" Background="{StaticResource ShellBackground}"
        Foreground="#EAF3F8" FontFamily="Segoe UI">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#0C1722" Padding="20,0">
      <DockPanel LastChildFill="True" VerticalAlignment="Center">
        <TextBlock Text="NUCtool" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
        <TextBlock Text="  /  Intel NUC Software Studio · WPF 模块宿主原型" FontSize="14" Foreground="#C3D0DA" />
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" Margin="20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#142330" CornerRadius="4" Padding="12">
        <StackPanel>
          <TextBlock Text="原版模块" Foreground="#92A6B5" Margin="8,8,8,12" />
          <Button Content="检测原版显示设置模块" Click="LoadOriginalView" Padding="10" HorizontalContentAlignment="Left" />
          <Button Content="EC 风扇控制模块" Click="OpenEcFanModule" Padding="10" Margin="0,8,0,0" HorizontalContentAlignment="Left" />
          <TextBlock x:Name="SourcePath" TextWrapping="Wrap" Foreground="#8194A3" FontSize="11" Margin="8,18,8,0" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource PanelBackground}" CornerRadius="4" Margin="14,0,0,0" Padding="16">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="原版模块安全探测" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
          <Border Grid.Row="1" Background="#EAF0F4" CornerRadius="2" Padding="10">
            <ContentControl x:Name="OriginalContent">
              <TextBlock x:Name="OriginalContentText" Text="探测模块前不会实例化厂商页面或触发硬件操作。" Foreground="#203543" TextWrapping="Wrap" VerticalAlignment="Top" />
            </ContentControl>
          </Border>
          <TextBlock x:Name="Status" Grid.Row="2" Text="等待加载。不会在此原型中执行硬件写入。" Foreground="#A8BAC7" TextWrapping="Wrap" Margin="0,12,0,0" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
