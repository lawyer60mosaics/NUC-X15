<UserControl x:Class="NssWpfHost.Ec.EcFanControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#EAF0F4">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="18" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="EC 风扇控制" FontSize="25" FontWeight="SemiBold" Foreground="#142330" />
      <TextBlock Text="风扇速度由 EC 控制。此模块当前直接调用 Uniwill WMI EC 接口。" FontSize="13" Foreground="#526977" Margin="0,5,0,18" />
      <Border Background="White" BorderBrush="#CBD8E0" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="硬件读回" FontSize="16" FontWeight="SemiBold" Foreground="#142330" />
            <TextBlock x:Name="Readback" Text="尚未读取" Foreground="#526977" Margin="0,8,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Content="读取当前状态" Click="ReadStatus" Padding="14,8" VerticalAlignment="Top" />
        </Grid>
      </Border>
      <Border Background="White" BorderBrush="#CBD8E0" BorderThickness="1" CornerRadius="4" Padding="16">
        <StackPanel>
          <TextBlock Text="手动风扇" FontSize="16" FontWeight="SemiBold" Foreground="#142330" />
          <TextBlock Text="必须先请求 EC 接管；调速请求目前会明确标记为未确认，读回转速用于观察硬件变化。" Foreground="#526977" TextWrapping="Wrap" Margin="0,6,0,14" />
          <TextBlock Text="左风扇速度" Foreground="#203543" />
          <DockPanel Margin="0,2,0,10">
            <TextBlock x:Name="LeftValue" DockPanel.Dock="Right" Width="48" Text="40%" VerticalAlignment="Center" Foreground="#203543" />
            <Slider x:Name="LeftFan" Minimum="0" Maximum="100" Value="40" ValueChanged="FanValueChanged" />
          </DockPanel>
          <TextBlock Text="右风扇速度" Foreground="#203543" />
          <DockPanel Margin="0,2,0,16">
            <TextBlock x:Name="RightValue" DockPanel.Dock="Right" Width="48" Text="40%" VerticalAlignment="Center" Foreground="#203543" />
            <Slider x:Name="RightFan" Minimum="0" Maximum="100" Value="40" ValueChanged="FanValueChanged" />
          </DockPanel>
          <WrapPanel>
            <Button Content="请求 EC 接管" Click="RequestManual" Padding="14,8" Margin="0,0,8,0" />
            <Button Content="应用风扇速度" Click="ApplySpeed" Padding="14,8" Margin="0,0,8,0" />
            <Button Content="交还 EC 自动" Click="ReturnToAuto" Padding="14,8" />
          </WrapPanel>
          <TextBlock x:Name="ActionStatus" Text="等待操作" Foreground="#526977" Margin="0,14,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
