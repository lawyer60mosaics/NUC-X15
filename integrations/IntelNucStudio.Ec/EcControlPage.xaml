<UserControl x:Class="IntelNucStudio.Ec.EcControlPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#243B4B" Foreground="#EEF4F7" FontFamily="Segoe UI" FontSize="15">
 <UserControl.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#FFFFFF"/>
   <Setter Property="Background" Value="#009FCC"/>
   <Setter Property="Padding" Value="18,9"/>
   <Setter Property="Margin" Value="0,0,10,8"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="BorderBrush" Value="#418197"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#0086AD"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="Metric" TargetType="TextBlock"><Setter Property="FontSize" Value="29"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,9,0,0"/></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="24,4,24,24">
   <TextBlock Text="EC 开启期间，官方设置将锁定。返回主页会保持 EC 控制；停止 EC 后可继续调整官方设置。退出时交还固件自动控制。" Foreground="#B9CBD5" TextWrapping="Wrap" Margin="0,0,0,18"/>
   <Border Background="#192D3B" Padding="22" Margin="0,0,0,16">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="CPU 温度" Foreground="#AABFCC"/><TextBlock x:Name="CpuTemperature" Text="—" Style="{StaticResource Metric}"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="dGPU 温度" Foreground="#AABFCC"/><TextBlock x:Name="GpuTemperature" Text="—" Style="{StaticResource Metric}"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="左风扇" Foreground="#AABFCC"/><TextBlock x:Name="LeftRpm" Text="—" Style="{StaticResource Metric}"/></StackPanel>
     <StackPanel Grid.Column="3"><TextBlock Text="右风扇" Foreground="#AABFCC"/><TextBlock x:Name="RightRpm" Text="—" Style="{StaticResource Metric}"/></StackPanel>
    </Grid>
   </Border>
   <TextBlock x:Name="ReadbackStatus" Text="正在读取硬件状态…" Foreground="#AABFCC" Margin="0,0,0,16" TextWrapping="Wrap"/>
   <Grid x:Name="ControlActions">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="#192D3B" Padding="22" Margin="0,0,8,0">
     <StackPanel>
      <TextBlock Text="自动温控" FontSize="22" Foreground="#00AFE5"/>
      <TextBlock Text="按 CPU 与显卡温度分别调节风扇，温度升高时自动加速。" Foreground="#B9CBD5" TextWrapping="Wrap" Margin="0,14,0,22"/>
      <Button Content="启用平衡温控" Click="StartCurve" HorizontalAlignment="Left"/>
      <TextBlock Text="温度保护始终启用。温度读取或写入异常时请求恢复固件自动控制。" Foreground="#94ACBB" TextWrapping="Wrap" Margin="0,16,0,0"/>
     </StackPanel>
    </Border>
    <Border Grid.Column="1" Background="#192D3B" Padding="22" Margin="8,0,0,0">
     <StackPanel>
      <TextBlock Text="固定转速" FontSize="22" Foreground="#00AFE5"/>
      <DockPanel Margin="0,16,0,8"><TextBlock Text="左风扇"/><TextBlock x:Name="LeftPercent" Text="40%" HorizontalAlignment="Right"/></DockPanel>
      <Slider x:Name="LeftSpeed" Minimum="20" Maximum="100" Value="40" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SpeedChanged"/>
      <DockPanel Margin="0,14,0,8"><TextBlock Text="右风扇"/><TextBlock x:Name="RightPercent" Text="40%" HorizontalAlignment="Right"/></DockPanel>
      <Slider x:Name="RightSpeed" Minimum="20" Maximum="100" Value="40" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SpeedChanged"/>
      <Button Content="应用固定转速" Click="ApplyFixed" HorizontalAlignment="Left" Margin="0,22,0,8"/>
      <TextBlock Text="最低 20%；高温保护可提高请求转速。滑块值不代表硬件已确认。" Foreground="#94ACBB" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
   </Grid>
   <WrapPanel Margin="0,20,0,0">
    <Button x:Name="ReleaseButton" Content="交还固件自动控制" Click="ReleaseControl"/>
    <Button Content="重新读取" Click="RefreshReadback" Background="#28495C"/>
   </WrapPanel>
   <Border Background="#102532" Padding="16" Margin="0,10,0,0">
    <StackPanel><TextBlock x:Name="ControlState" Text="尚未请求 EC 接管" Foreground="#00AFE5" FontWeight="SemiBold"/>
     <TextBlock x:Name="ActionStatus" Text="进入此页仅读取状态；选择操作后才会发送风扇控制请求。" Foreground="#B9CBD5" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
