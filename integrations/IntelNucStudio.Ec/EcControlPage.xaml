<UserControl x:Class="IntelNucStudio.Ec.EcControlPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource MainBackgroundBrush}" Foreground="{DynamicResource MainTextBrush}"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="15" SizeChanged="LayoutSizeChanged">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Industrial.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style TargetType="Button" BasedOn="{StaticResource IndustrialButton}"><Setter Property="Margin" Value="0,0,10,8"/></Style>
   <Style x:Key="Metric" TargetType="TextBlock">
    <Setter Property="FontSize" Value="30"/><Setter Property="FontFamily" Value="Bahnschrift, Segoe UI"/>
    <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,8,0,0"/>
   </Style>
   <Style x:Key="Panel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="2"/><Setter Property="Padding" Value="20"/>
   </Style>
   <Style x:Key="SecondaryText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource IndustrialMutedBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="23"/>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,4,28,24">
  <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="EC 只管理风扇。返回主页后继续运行，退出程序时交还自动控制。" Style="{StaticResource SecondaryText}" Margin="0,0,0,16"/>
   <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="0">
    <UniformGrid x:Name="MetricsGrid" Columns="4">
     <Border Padding="20,16" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,1,0"><StackPanel><TextBlock Text="CPU 温度" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="CpuTemperature" Text="—" Style="{StaticResource Metric}"/></StackPanel></Border>
     <Border Padding="20,16" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,1,0"><StackPanel><TextBlock Text="dGPU 温度" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="GpuTemperature" Text="—" Style="{StaticResource Metric}"/></StackPanel></Border>
     <Border Padding="20,16" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,1,0"><StackPanel><TextBlock Text="左风扇" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="LeftRpm" Text="—" Style="{StaticResource Metric}"/></StackPanel></Border>
     <Border Padding="20,16"><StackPanel><TextBlock Text="右风扇" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="RightRpm" Text="—" Style="{StaticResource Metric}"/></StackPanel></Border>
    </UniformGrid>
   </Border>
   <TextBlock Grid.Row="2" x:Name="ReadbackStatus" Text="正在读取硬件状态…" Style="{StaticResource SecondaryText}" Margin="0,12,0,20"/>
   <Grid Grid.Row="3" x:Name="ControlActions">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border x:Name="AutomaticPanel" Style="{StaticResource Panel}" Margin="0,0,8,0">
     <StackPanel>
      <DockPanel><TextBlock Text="01" Foreground="{StaticResource IndustrialMutedBrush}" Margin="0,5,12,0"/><TextBlock Text="自动温控" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource IconBrush}"/></DockPanel>
      <TextBlock Text="选择档位即可启用，运行中可直接切换。" Style="{StaticResource SecondaryText}" Margin="0,14,0,18"/>
      <WrapPanel>
       <Button x:Name="QuietPreset" Content="静音" Tag="Quiet" Click="SelectPreset" MinWidth="84"/>
       <Button x:Name="BalancedPreset" Content="平衡" Tag="Balanced" Click="SelectPreset" MinWidth="84"/>
       <Button x:Name="PerformancePreset" Content="性能" Tag="Performance" Click="SelectPreset" MinWidth="84"/>
      </WrapPanel>
      <TextBlock x:Name="PresetDescription" Text="静音降低噪声，平衡适合日常，性能优先散热。" Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/>
      <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,14,0,0">
       <TextBlock Text="设备性能请在官方性能页面设置。温度保护始终开启。" Style="{StaticResource SecondaryText}"/>
      </Border>
     </StackPanel>
    </Border>
    <Border x:Name="FixedPanel" Grid.Column="1" Style="{StaticResource Panel}" Margin="8,0,0,0">
     <StackPanel>
      <DockPanel><TextBlock Text="02" Foreground="{StaticResource IndustrialMutedBrush}" Margin="0,5,12,0"/><TextBlock Text="固定转速" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource IconBrush}"/></DockPanel>
      <DockPanel Margin="0,16,0,8"><TextBlock Text="左风扇"/><TextBlock x:Name="LeftPercent" Text="40%" HorizontalAlignment="Right" FontWeight="SemiBold"/></DockPanel>
      <Slider x:Name="LeftSpeed" Style="{StaticResource IndustrialSlider}" Minimum="20" Maximum="100" Value="40" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SpeedChanged" AutomationProperties.Name="左风扇请求转速百分比"/>
      <DockPanel Margin="0,14,0,8"><TextBlock Text="右风扇"/><TextBlock x:Name="RightPercent" Text="40%" HorizontalAlignment="Right" FontWeight="SemiBold"/></DockPanel>
      <Slider x:Name="RightSpeed" Style="{StaticResource IndustrialSlider}" Minimum="20" Maximum="100" Value="40" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SpeedChanged" AutomationProperties.Name="右风扇请求转速百分比"/>
      <Button Content="应用固定转速" Click="ApplyFixed" HorizontalAlignment="Left" Margin="0,20,0,8"/>
      <TextBlock Text="最低 20%；高温保护可能提高转速。实际运行请看 RPM 读回。" Style="{StaticResource SecondaryText}"/>
     </StackPanel>
    </Border>
   </Grid>
   <WrapPanel Grid.Row="4" Margin="0,20,0,0">
    <Button x:Name="ReleaseButton" Content="交还固件自动控制" Click="ReleaseControl" Style="{StaticResource IndustrialPrimaryButton}" Margin="0,0,10,8"/>
    <Button Content="重新读取" Click="RefreshReadback"/>
   </WrapPanel>
   <Border Grid.Row="5" Style="{StaticResource Panel}" Background="{StaticResource IndustrialInputBrush}" Padding="16" Margin="0,8,0,0">
    <StackPanel><TextBlock x:Name="ControlState" Text="尚未请求 EC 接管" Foreground="{StaticResource IconBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock x:Name="ActionStatus" Text="选择操作后才会发送风扇控制请求。" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
    </StackPanel>
   </Border>
  </Grid>
 </ScrollViewer>
</UserControl>
